Name     V102-IO1-0 ;
PartNo   00 ;
Date     10/6/23 ;
Revision 0 ;
Designer Nigel ;
Company  xxx ;
Assembly None ;
Location  ;
Device   g16v8a ;

/* *************** INPUT PINS *********************/
PIN 	1 	    = 	    IORQB 	    ; /*                */
PIN  	2   	=   	A0  	    ; /*                */ 
PIN  	3   	=   	A1 	        ; /*                */ 
PIN  	4   	=  	    A2   	    ; /*                */ 
PIN  	5   	=   	A3   	    ; /*                */ 
PIN  	6   	=   	A4   	    ; /*                */ 
PIN  	7   	=   	A5   	    ; /*                */ 
PIN  	8   	=   	A6  	    ; /*                */ 
PIN  	9   	=   	A7  	    ; /*                */ 
PIN  	11  	=   	RDB  	    ; /*                */ 
PIN  	12  	=   	WRB  	    ; /*                */ 

FIELD ADDR      =       [A7..A0]    ;

/* *************** OUTPUT PINS *********************/
PIN  	19	    =       PORTCOUT	; /*         */ 
PIN  	18	    =       OUT5  	    ;           
PIN  	17   	=       IN6  	    ;         
PIN  	16   	=       IN5  	    ;           
PIN  	15   	=       CTCB  	    ; /*         */ 
PIN  	14   	=       PIOB  	    ; /*         */ 
PIN  	13   	=       SIOB  	    ; /*         */ 

/* *************** LOGIC FORMULA *********************/

!PORTCOUT	=   (ADDR:7         &   !IORQB  &   !WRB)   ; /* output port 7 - 0000 0111 */ 
!CTCB		=   (ADDR:[8..B]    &   !IORQB)             ; /* CTC1 IN and OUT 8,9,A,B */
!PIOB		=   (ADDR:[10..13]  &   !IORQB) 	        ; /* PIO1 IN and OUT 10,11,12,13 */
!SIOB		=   (ADDR:[C..F]    &   !IORQB)    	        ; /* SIO IN and OUT C,D,E,F */

!IN5        =   (ADDR:5         &   !IORQB  &   !RDB)   ;
!IN6        =   (ADDR:6         &   !IORQB  &   !RDB)   ;
!OUT5       =   (ADDR:5         &   !IORQB  &   !WRB)   ;

 



